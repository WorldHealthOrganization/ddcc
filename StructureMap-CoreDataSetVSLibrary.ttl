\"set practitioner\"</i><span style=\"color: navy\">;</span>#xD;\n  src<span style=\"color: navy\"><b> -&gt; </b></span>immunization.protocolApplied<b> as </b><span style=\"color: maroon\">protocol</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>    src<span style=\"color: navy\"><b> -&gt; </b></span>protocol.authority<b> as </b><span style=\"color: maroon\">authority</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      certificate.issuer<b> as </b><span style=\"color: maroon\">issuer</span><span style=\"color: navy\"><b> -&gt; </b></span>authority.type = <span style=\"color: blue\">'Organization'</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>        issuer.identifier<b> as </b><span style=\"color: maroon\">pha</span><span style=\"color: navy\"><b> -&gt; </b></span>authority.identifier<b> as </b><span style=\"color: maroon\">identifier</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>          pha.value<b> as </b><span style=\"color: maroon\">value</span><span style=\"color: navy\"><b> -&gt; </b></span>identifier.value = <span style=\"color: maroon\">value</span> <i>\"set pha\"</i><span style=\"color: navy\">;</span>#xD;\n        <span style=\"color: navy\">}</span> <i>\"set issuer identifier\"</i><span style=\"color: navy\">;</span>#xD;\n      <span style=\"color: navy\">}</span> <i>\"set issuer\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"color: navy\">}</span> <i>\"set authority\"</i><span style=\"color: navy\">;</span>#xD;\n    src.disease<b> as </b><span style=\"color: maroon\">disease</span><span style=\"color: navy\"><b> -&gt; </b></span>protocol.targetDisease<b> as </b><span style=\"color: maroon\">tdisease</span><b> then</b><span style=\"color: navy\"> {#xD;\n</span>      disease<span style=\"color: navy\"><b> -&gt; </b></span>tdisease.coding = <span style=\"color: maroon\">disease</span> <i>\"set target disease code\"</i><span style=\"color: navy\">;</span>#xD;\n    <span style=\"col