     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap who-ddcc-map-ichi-sct-specimen-origin</b></p><a name=\"who-ddcc-map-ichi-sct-specimen-origin\"> </a><a name=\"hcwho-ddcc-map-ichi-sct-specimen-origin\"> </a><p>This mapping does not specify any particular context of use.</p><br/><p>Mapping from <code>http://id.who.int/icd11/mms</code> to <a href=\"CodeSystem-WHODDCCsnomed.html\">SNOMED codes used in this IG</a></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td></tr><tr><td>JAM.AH.XF</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>258500001 (Nasopharyngeal swab)</td></tr><tr><td>KAR.AH.XF</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>461911000124106 (Oropharyngeal swab)</td></tr><tr><td>KAR.AH.XF</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>472881004 (Swab from pharynx)</td></tr><tr><td>JAE.AH.XF</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>472901003 (Swab from nasal sinus)</td></tr><tr><td>KAZ.AH.XD</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>119342007 (Saliva specimen)</td></tr><tr><td>DIA.AH.XA</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>119297000 (Blood specimen)</td></tr><tr><td>DIA.AH.XA</td><td><a href=\"http://hl7