                 a fhir:string ;
                 fhir:v "who-ddcc-map-cvx-icd11-vaccines"
               ]
             ] [
               fhir:value [
                 a fhir:string ;
                 fhir:v "Coding"
               ]
             ] )
           ] )
         ] )
       ] [
         fhir:name [ fhir:v "translate brand" ] ;
         fhir:source ( [
           fhir:context [ fhir:v "vaccine" ] ;
