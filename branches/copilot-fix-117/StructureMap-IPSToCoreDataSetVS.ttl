       ] [
         fhir:context [ fhir:v "ddcc" ] ;
         fhir:contextType [ fhir:v "variable" ] ;
         fhir:element [ fhir:v "name" ] ;
         fhir:transform [ fhir:v "append" ] ;
         fhir:parameter ( [
           fhir:value [
             a fhir:id ;
             fhir:v "tName"
           ]
         ] [
           fhir:value [
             a fhir:id ;
             fhir:v "spaced"
           ]
