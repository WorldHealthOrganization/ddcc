             fhir:variable [ fhir:v "system" ]
           ] ) ;
           fhir:target ( [
             fhir:context [ fhir:v "vMan" ] ;
             fhir:contextType [ fhir:v "variable" ] ;
             fhir:element [ fhir:v "system" ] ;
             fhir:transform [ fhir:v "copy" ] ;
