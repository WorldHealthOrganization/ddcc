       ] [
         fhir:name [ fhir:v "translate vaccine coding" ] ;
         fhir:source ( [
           fhir:context [ fhir:v "vaccine" ] ;
           fhir:element [ fhir:v "coding" ] ;
           fhir:variable [ fhir:v "coding" ] ;
