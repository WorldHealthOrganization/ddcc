{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-DDCCCoreDataSetTR.schema.json",
  "title": "DDCC Core Data Set Logical Model for Test Result",
  "description": "Data elements for the DDCC Core Data Set for Test Result.",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "DDCCCoreDataSetTR",
      "description": "Resource type identifier for DDCCCoreDataSetTR logical model"
    },
    "@context": {
      "description": "JSON-LD context for this logical model with ValueSet vocabularies",
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "URI reference to external JSON-LD context"
        },
        {
          "type": "object",
          "description": "Inline JSON-LD context",
          "properties": {
            "@version": {
              "type": "number",
              "const": 1.1
            },
            "fhir": {
              "type": "string",
              "const": "http://hl7.org/fhir/"
            }
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        {
          "type": "array",
          "description": "Array of JSON-LD context objects/URIs",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "@type": {
      "type": "string",
      "description": "JSON-LD type identifier for DDCCCoreDataSetTR logical model",
      "examples": [
        "LogicalModel-DDCCCoreDataSetTR"
      ]
    },
    "DDCCCoreDataSet": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "FHIR "
      },
      "description": "Data elements for the DDCC Core Data Set for Test Result."
    },
    "name": {
      "type": "string",
      "description": "The full name of the person."
    },
    "birthDate": {
      "type": "string",
      "format": "date",
      "description": "The person's date of birth (DOB) if known. If unknown, use given DOB for administrative purposes"
    },
    "identifier": {
      "type": "object",
      "description": "Unique identifier for the person, according to the policies applicable to each country. There can be more than one unique identifier used to link records. (e.g. national ID, health ID, immunization information system ID, medical record ID)."
    },
    "certificate": {
      "type": "object",
      "description": "Metadata associated with the certificate"
    },
    "id": {
      "type": "object",
      "description": "Unique id for the element within a resource (for internal references). This may be any string value that does not contain spaces."
    },
    "modifierExtension": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "FHIR Extension"
      },
      "description": "May be used to represent additional information that is not part of the basic definition of the element and that modifies the understanding of the element in which it is contained and/or the understanding of the containing element's descendants. Usually modifier elements provide negation or qualification. To make the use of extensions safe and manageable, there is a strict set of governance applied to the definition and use of extensions. Though any implementer can define an extension, there is a set of requirements that SHALL be met as part of the definition of the extension. Applications processing a resource are required to check for modifier extensions.\n\nModifier extensions SHALL NOT change the meaning of any elements on Resource or DomainResource (including cannot change the meaning of modifierExtension itself)."
    },
    "issuer": {
      "type": "object",
      "description": "Certificate issuer."
    },
    "kid": {
      "type": "string",
      "description": "Key ID"
    },
    "hcid": {
      "type": "object",
      "description": "Health certificate identifier (HCID)."
    },
    "ddccid": {
      "type": "object",
      "description": "DDCC Identifier"
    },
    "version": {
      "type": "string",
      "description": "Certificate schema version"
    },
    "period": {
      "type": "object",
      "description": "Certificate validity period."
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "description": "Start date of certificate validity."
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "description": "End date of certificate validity."
    },
    "test": {
      "type": "object",
      "description": "A test event."
    },
    "pathogen": {
      "oneOf": [
        {
          "type": "object",
          "description": "FHIR Coding from ValueSet WHODDCCAgentTargetedCOVID19",
          "properties": {
            "system": {
              "type": "string",
              "description": "Code system URI"
            },
            "code": {
              "type": "string",
              "description": "Code value"
            },
            "display": {
              "type": "string",
              "description": "Human readable display text"
            }
          },
          "required": [
            "system",
            "code"
          ]
        },
        {
          "type": "object",
          "description": "Coding from ValueSet WHODDCCAgentTargetedCOVID19 (JSON-LD structure)",
          "properties": {
            "@type": {
              "type": "string",
              "const": "http://smart.who.int/base/ValueSet-WHODDCCAgentTargetedCOVID19.jsonld",
              "description": "JSON-LD type reference to ValueSet WHODDCCAgentTargetedCOVID19"
            },
            "@id": {
              "type": "string",
              "format": "uri",
              "description": "Full IRI of the code from ValueSet WHODDCCAgentTargetedCOVID19"
            }
          },
          "required": [
            "@type",
            "@id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Name of the pathogen being tested for (such as SARS-CoV-2)."
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "description": "FHIR Coding from ValueSet WHODDCCTypeofTestCOVID19",
          "properties": {
            "system": {
              "type": "string",
              "description": "Code system URI"
            },
            "code": {
              "type": "string",
              "description": "Code value"
            },
            "display": {
              "type": "string",
              "description": "Human readable display text"
            }
          },
          "required": [
            "system",
            "code"
          ]
        },
        {
          "type": "object",
          "description": "Coding from ValueSet WHODDCCTypeofTestCOVID19 (JSON-LD structure)",
          "properties": {
            "@type": {
              "type": "string",
              "const": "http://smart.who.int/base/ValueSet-WHODDCCTypeofTestCOVID19.jsonld",
              "description": "JSON-LD type reference to ValueSet WHODDCCTypeofTestCOVID19"
            },
            "@id": {
              "type": "string",
              "format": "uri",
              "description": "Full IRI of the code from ValueSet WHODDCCTypeofTestCOVID19"
            }
          },
          "required": [
            "@type",
            "@id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Name of the type of test that was conducted e.g. NAAT."
    },
    "brand": {
      "type": "object",
      "description": "The brand or trade name used to refer to the test conducted."
    },
    "manufacturer": {
      "type": "object",
      "description": "Name of the manufacturer of the test conducted."
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "description": "FHIR Coding from ValueSet WHODDCCSampleOriginCOVID19",
          "properties": {
            "system": {
              "type": "string",
              "description": "Code system URI"
            },
            "code": {
              "type": "string",
              "description": "Code value"
            },
            "display": {
              "type": "string",
              "description": "Human readable display text"
            }
          },
          "required": [
            "system",
            "code"
          ]
        },
        {
          "type": "object",
          "description": "Coding from ValueSet WHODDCCSampleOriginCOVID19 (JSON-LD structure)",
          "properties": {
            "@type": {
              "type": "string",
              "const": "http://smart.who.int/base/ValueSet-WHODDCCSampleOriginCOVID19.jsonld",
              "description": "JSON-LD type reference to ValueSet WHODDCCSampleOriginCOVID19"
            },
            "@id": {
              "type": "string",
              "format": "uri",
              "description": "Full IRI of the code from ValueSet WHODDCCSampleOriginCOVID19"
            }
          },
          "required": [
            "@type",
            "@id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The type of sample that was taken  e.g. Nasopharyngeal swab or Saliva specimen."
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time when sample was collected."
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "description": "FHIR Coding from ValueSet who-ddcc-test-result-covid-19",
          "properties": {
            "system": {
              "type": "string",
              "description": "Code system URI"
            },
            "code": {
              "type": "string",
              "description": "Code value"
            },
            "display": {
              "type": "string",
              "description": "Human readable display text"
            }
          },
          "required": [
            "system",
            "code"
          ]
        },
        {
          "type": "object",
          "description": "Coding from ValueSet who-ddcc-test-result-covid-19 (JSON-LD structure)",
          "properties": {
            "@type": {
              "type": "string",
              "const": "http://smart.who.int/base/ValueSet-who-ddcc-test-result-covid-19.jsonld",
              "description": "JSON-LD type reference to ValueSet who-ddcc-test-result-covid-19"
            },
            "@id": {
              "type": "string",
              "format": "uri",
              "description": "Full IRI of the code from ValueSet who-ddcc-test-result-covid-19"
            }
          },
          "required": [
            "@type",
            "@id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Detected or Not detected presence of SARS-CoV-2 infection."
    },
    "centre": {
      "type": "object",
      "description": "A codable name or identifier of the facility responsible for conducting the test."
    },
    "country": {
      "oneOf": [
        {
          "type": "object",
          "description": "FHIR Coding from ValueSet iso3166-1-3",
          "properties": {
            "system": {
              "type": "string",
              "description": "Code system URI"
            },
            "code": {
              "type": "string",
              "description": "Code value"
            },
            "display": {
              "type": "string",
              "description": "Human readable display text"
            }
          },
          "required": [
            "system",
            "code"
          ]
        },
        {
          "type": "object",
          "description": "Coding from ValueSet iso3166-1-3 (JSON-LD structure)",
          "properties": {
            "@type": {
              "type": "string",
              "const": "http://smart.who.int/base/ValueSet-iso3166-1-3.jsonld",
              "description": "JSON-LD type reference to ValueSet iso3166-1-3"
            },
            "@id": {
              "type": "string",
              "format": "uri",
              "description": "Full IRI of the code from ValueSet iso3166-1-3"
            }
          },
          "required": [
            "@type",
            "@id"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The country in which the individual has been tested."
    }
  },
  "required": [
    "resourceType",
    "name",
    "issuer",
    "hcid",
    "version",
    "test",
    "pathogen",
    "type",
    "date",
    "country"
  ],
  "resourceDefinition": "http://smart.who.int/ddcc/StructureDefinition/DDCCCoreDataSetTR",
  "fhir:parent": "http://smart.who.int/ddcc/StructureDefinition/DDCCCoreDataSet",
  "jsonld:valuesets": [
    "who-ddcc-test-result-covid-19",
    "WHODDCCAgentTargetedCOVID19",
    "iso3166-1-3",
    "WHODDCCSampleOriginCOVID19",
    "WHODDCCTypeofTestCOVID19"
  ],
  "jsonld:contextTemplate": {
    "@version": 1.1,
    "fhir": "http://hl7.org/fhir/",
    "who-ddcc-test-result-covid-19": "http://smart.who.int/base/ValueSet-who-ddcc-test-result-covid-19.jsonld",
    "WHODDCCAgentTargetedCOVID19": "http://smart.who.int/base/ValueSet-WHODDCCAgentTargetedCOVID19.jsonld",
    "iso3166-1-3": "http://smart.who.int/base/ValueSet-iso3166-1-3.jsonld",
    "WHODDCCSampleOriginCOVID19": "http://smart.who.int/base/ValueSet-WHODDCCSampleOriginCOVID19.jsonld",
    "WHODDCCTypeofTestCOVID19": "http://smart.who.int/base/ValueSet-WHODDCCTypeofTestCOVID19.jsonld"
  }
}