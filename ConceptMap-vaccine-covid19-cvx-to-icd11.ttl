     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ConceptMap vaccine-covid19-cvx-to-icd11</b></p><a name=\"vaccine-covid19-cvx-to-icd11\"> </a><a name=\"hcvaccine-covid19-cvx-to-icd11\"> </a><p>This mapping does not specify any particular context of use.</p><br/><p>Mapping from <a href=\"CodeSystem-WHODDCCcvx.html\">CVX codes used in this IG</a> to <code>http://id.who.int/icd11/mms</code></p><table class=\"grid\"><tr><td><b>Source Code</b></td><td><b>Relationship</b></td><td><b>Target Code</b></td></tr><tr><td>207 (COVID-19, mRNA, LNP-S, PF, 100 mcg/0.5mL dose or 50 mcg/0.25mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>208 (COVID-19, mRNA, LNP-S, PF, 30 mcg/0.3 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>210 (COVID-19 vaccine, vector-nr, rS-ChAdOx1, PF, 0.5 mL )</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM4YL8 (COVID-19 Vaccine AstraZeneca)</td></tr><tr><td>211 (COVID-19, subunit, rS-nanoparticle+Matrix-M1 Adjuvant, PF, 0.5 mL)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM9T65 (Novavax COVID-19 vaccine)</td></tr><tr><td>212 (COVID-19 vaccine, vector-nr, rS-Ad26, PF, 0.5 mL)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM6QV1 (COVID-19 Vaccine Janssen)</td></tr><tr><td>213 (SARS-COV-2 (COVID-19) vaccine, UNSPECIFIED)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM68M6 (COVID-19 vaccines)</td></tr><tr><td>217 (COVID-19, mRNA, LNP-S, PF, 30 mcg/0.3 mL dose, tris-sucrose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>218 (COVID-19, mRNA, LNP-S, PF, 10 mcg/0.2 mL dose, tris-sucrose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>219 (COVID-19, mRNA, LNP-S, PF, 3 mcg/0.2 mL dose, tris-sucrose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>221 (COVID-19, mRNA, LNP-S, PF, 50 mcg/0.5 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>225 (COVID-19, D614, recomb, preS dTM, AS03 adjuvant add, PF, 5mcg/0.5mL)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3CT4 (Recombinant SARS-CoV-2 vaccine)</td></tr><tr><td>226 (COVID-19, D614, recomb, preS dTM, AS03 adjuvant add, PF, 10mcg/0.5mL)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3CT4 (Recombinant SARS-CoV-2 vaccine)</td></tr><tr><td>227 (COVID-19, mRNA, LNP-S, PF, pediatric 50 mcg/0.5 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>228 (COVID-19, mRNA, LNP-S, PF, pediatric 25 mcg/0.25 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>229 (COVID-19, mRNA, LNP-S, bivalent booster, PF, 50 mcg/0.5 mL or 25mcg/0.25 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>230 (COVID-19, mRNA, LNP-S, bivalent booster, PF, 10 mcg/0.2 mL)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>300 (COVID-19, mRNA, LNP-S, bivalent booster, PF, 30 mcg/0.3 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>301 (COVID-19, mRNA, LNP-S, bivalent booster, PF, 10 mcg/0.2 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>302 (COVID-19, mRNA, LNP-S, bivalent, PF, 3 mcg/0.2 mL dose)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM8NQ0 (Comirnaty)</td></tr><tr><td>500 (COVID-19 Non-US Vaccine, Product Unknown)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM68M6 (COVID-19 vaccines)</td></tr><tr><td>501 (COVID-19 IV Non-US Vaccine (QAZCOVID-IN))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM1NL1 (COVID-19 vaccine, inactivated virus)</td></tr><tr><td>502 (COVID-19 IV Non-US Vaccine (COVAXIN))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1G90 (Covaxin)</td></tr><tr><td>503 (COVID-19 LAV Non-US Vaccine (COVIVAC))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM85P5 (Covi-Vac)</td></tr><tr><td>504 (COVID-19 VVnr Non-US Vaccine (Sputnik Light))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM5QM6 (Sputnik-Light)</td></tr><tr><td>505 (COVID-19 VVnr Non-US Vaccine (Sputnik V))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM5ZJ4 (Gam-Covid-Vac)</td></tr><tr><td>506 (COVID-19 VVnr Non-US Vaccine (CanSino Biological Inc./Beijing Institute of Biotechnology))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM1AG7 (Convidecia)</td></tr><tr><td>507 (COVID-19 PS Non-US Vaccine (Anhui Zhifei Longcom Biopharm + Inst of Micro, Chinese Acad of Sciences))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM5JC5 (COVID-19 vaccine, virus protein subunit)</td></tr><tr><td>508 (COVID-19 PS Non-US Vaccine (Jiangsu Province Centers for Disease Control and Prevention))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM5JC5 (COVID-19 vaccine, virus protein subunit)</td></tr><tr><td>509 (COVID-19 PS Non-US Vaccine (EpiVacCorona))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM6SZ8 (EpiVacCorona)</td></tr><tr><td>510 (COVID-19 IV Non-US Vaccine (BIBP, Sinopharm))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM8866 (BBIBP-CorV)</td></tr><tr><td>511 (COVID-19 IV Non-US Vaccine (CoronaVac, Sinovac))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM7HT3 (CoronaVac®)</td></tr><tr><td>512 (SARS-COV-2 COVID-19 VLP Non-US Vaccine (Medicago, Covifenz))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM1J92 (COVID-19 vaccine, virus like particle)</td></tr><tr><td>513 (SARS-COV-2 COVID-19 PS Non-US Vaccine (Anhui Zhifei Longcom, Zifivax))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM5JC5 (COVID-19 vaccine, virus protein subunit)</td></tr><tr><td>514 (SARS-COV-2 COVID-19 DNA Non-US Vaccine (Zydus Cadila, ZyCoV-D))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM52P3 (ZvCov-D)</td></tr><tr><td>515 (SARS-COV-2 COVID-19 PS Non-US Vaccine (Medigen, MVC-COV1901))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM4EC8 (MVC-COV1901)</td></tr><tr><td>516 (COV-2 COVID-19 Inactivated Non-US Vaccine Product (Minhai Biotechnology Co, KCONVAC))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM9TQ1 (KCONVAC)</td></tr><tr><td>517 (SARS-COV-2 COVID-19 PS Non-US Vaccine (Biological E Limited, Corbevax))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM5JC5 (COVID-19 vaccine, virus protein subunit)</td></tr><tr><td>518 (COVID-19 Inactivated, Non-US Vaccine (VLA2001, Valneva))</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-wider\" title=\"wider\">maps to wider concept</a></td><td>XM1NL1 (COVID-19 vaccine, inactivated virus)</td></tr><tr><td>519 (COVID-19 mRNA, bivalent, original/Omicron BA.1, Non-US Vaccine (Spikevax Bivalent), Moderna)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM3DT5 (COVID-19 Vaccine Moderna)</td></tr><tr><td>520 (COVID-19 mRNA, bivalent, original/Omicron BA.1, Non-US Vaccine Product, Pfizer-BioNTech)</td><td><a href=\"http://hl7.org/fhir/R4/codesystem-concept-map-equivalence.html#concept-map-equivalence-equivalent\" title=\"equivalent\">is equivalent to</a></td><td>XM8NQ0 (Comirnaty)</td></tr></table></div>"
